{
  "version": 2,
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.9.0",
      "excludeFiles": "{games/**,assets/**}"
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/$", "dest": "/api/index.php?path=index.php" },
    { "src": "/admin", "status": 308, "headers": { "Location": "/admin/" } },
    { "src": "/admin/(.*)", "dest": "/api/index.php?path=admin/$1" },
    { "src": "/index.html", "dest": "/api/index.php?path=index.php" },
    { "src": "/game.html", "dest": "/api/index.php?path=game.php" },
    { "src": "/(.*\\.php)", "dest": "/api/index.php?path=$1" }
  ]
}