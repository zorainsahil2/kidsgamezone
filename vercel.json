{
  "version": 2,
  "builds": [
    { "src": "api/**/*.php", "use": "vercel-php@0.7.3" },
    { "src": "admin/**/*.php", "use": "vercel-php@0.7.3" },
    { "src": "*.php", "use": "vercel-php@0.7.3" },
    { "src": "**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/admin/(.*)", "dest": "/admin/$1" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}